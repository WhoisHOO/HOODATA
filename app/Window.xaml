<!-- HOODATA window: shows that HOODATA is running and opens the dashboard. Text comes from strings.json, so this
     file stays ASCII. Muted text is #595959 on white (7:1); focused buttons get an outline. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOODATA" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="White"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Foreground="#1A1A1A"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#595959"/>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="#111111" BorderBrush="#111111" BorderThickness="2" Padding="16,10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#8A8A8A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A8A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="White" BorderBrush="#767676" BorderThickness="1" Padding="16,10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,22">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="HOODATA" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="Version" Margin="10,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}"/>
    </StackPanel>

    <TextBlock x:Name="Status" Margin="0,14,0,0" FontSize="14" TextWrapping="Wrap"/>
    <TextBox x:Name="Address" Margin="0,4,0,0" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent"
             Foreground="{StaticResource Muted}" FontSize="12"/>
    <TextBox x:Name="Folder" Margin="0,2,0,0" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent"
             Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock x:Name="Warning" Margin="0,10,0,0" FontSize="12" Foreground="#8A5A00" TextWrapping="Wrap" Visibility="Collapsed"/>

    <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="OpenButton" Grid.Column="0" Style="{StaticResource Primary}" IsDefault="True"/>
      <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource Secondary}"/>
    </Grid>

    <TextBlock x:Name="Hint" Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
